# Copy this file to .env and fill in the values.
# Generate each value with: python -c "import secrets; print(secrets.token_hex(32))"

AUTH_SECRET=
ENCRYPTION_KEY=

# Deployment environment — tags every log line and controls stack-trace
# verbosity (full in development/staging, error type + fingerprint only in
# production). One of: development | staging | production. Default: development.
UVALU_ENV=development

# Optional — on a fresh deployment (empty user store), creates this account
# as Admin at startup. The sign-in wall is invite-only, so this (or
# scripts/create_admin.py) is the only way to get a first account. Both must
# be set together, or bootstrap is skipped.
#ADMIN_EMAIL=
#ADMIN_PASSWORD=
