# Uvalu app (SR2, docs/deployment.md). Copy to /etc/systemd/system/uvalu.service.
[Unit]
Description=Uvalu (Streamlit, behind Caddy)
After=network-online.target
Wants=network-online.target

[Service]
User=uvalu
Group=uvalu
WorkingDirectory=/opt/uvalu
Environment=UVALU_BEHIND_PROXY=1
Environment=PORT=8501
ExecStart=/opt/uvalu/.venv/bin/python run_app.py
Restart=on-failure
RestartSec=5

# Hardening: the app writes only inside /opt/uvalu (data, .cache, logs,
# static/version.json); new files are private to the uvalu user.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/uvalu
UMask=0077

[Install]
WantedBy=multi-user.target
