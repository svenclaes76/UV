# Uvalu reverse proxy (SR2, docs/deployment.md). Copy to /etc/caddy/Caddyfile.
# Caddy gets and renews the Let's Encrypt certificate itself, redirects HTTP
# to HTTPS, and proxies the websocket Streamlit uses.

uvalu.app {
	encode zstd gzip

	# Streamlit listens on localhost only (run_app.py, UVALU_BEHIND_PROXY=1).
	# Caddy sets X-Forwarded-For to the client address; the app reads it for
	# the per-IP sign-in limit (uvalu/authgate.py _client_ip).
	reverse_proxy 127.0.0.1:8501

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		# Report-only first: Streamlit and the app's st.iframe scripts need
		# inline script and style. Check the browser console on every page,
		# then rename the header to Content-Security-Policy (docs/deployment.md
		# step 8). frame-ancestors, object-src, base-uri and form-action are
		# what this policy mainly adds.
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' wss://uvalu.app; frame-src 'self' blob: data:; worker-src 'self' blob:; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	log {
		output file /var/log/caddy/uvalu.log {
			roll_keep_for 744h  # 31 days, as the privacy notice says for security logs
		}
	}
}

www.uvalu.app {
	redir https://uvalu.app{uri} permanent
}
