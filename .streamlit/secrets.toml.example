# Copy this file to secrets.toml (gitignored — never commit real secrets)
# to enable Google/Microsoft sign-in (uvalu/oauth.py). Uvalu has no OAuth
# credentials configured by default; without this file, every provider
# button on the sign-in wall shows as "not configured" and the app works
# exactly as it does today (password-only).
#
# Shared settings every provider needs, once — NOT per-provider:
[auth]
redirect_uri = "https://localhost:8501/oauth2callback"  # must match your deployment's real URL + /oauth2callback
cookie_secret = "generate-a-random-32+-char-string-here"

# Google — see https://developers.google.com/identity/openid-connect/openid-connect
# for how to obtain client_id/client_secret from Google Cloud Console.
[auth.google]
client_id = ""
client_secret = ""
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# Microsoft Entra ID — uncomment and fill in once Phase 1's build order (see
# docs/uvalu-auth-implementation-plan.md) actually adds it. Until configured,
# it just renders as the disabled "not configured" entry in the provider list
# (uvalu/oauth.py's PROVIDERS tuple).
# [auth.microsoft]
# client_id = ""
# client_secret = ""
# server_metadata_url = "https://login.microsoftonline.com/{tenant}/v2.0/.well-known/openid-configuration"

# Also requires the Authlib dependency (already pinned in requirements.txt)
# and, per Admin -> Security's "Auto-provision on first provider sign-in"
# toggle, an allowed-domains list if you want unrecognized addresses in your
# own domain to get an account automatically instead of being refused.
