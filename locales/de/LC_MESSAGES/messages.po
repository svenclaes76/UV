#: auth.py:959
msgid "This provider is already linked to your account."
msgstr "Dieser Anbieter ist bereits mit deinem Konto verknüpft."

#. Context: Settings › Linked accounts › confirmation
#: auth.py:966
msgid "Provider connected."
msgstr "Anbieter verbunden."

#. Context: Settings › Linked accounts › error
#: auth.py:981
msgid "That provider isn't linked to your account."
msgstr "Dieser Anbieter ist nicht mit deinem Konto verknüpft."

#. Context: Settings › Linked accounts › error
#: auth.py:983
msgid "Can't disconnect your only sign-in method — set a password first."
msgstr ""
"Deine einzige Anmeldemethode kann nicht getrennt werden – lege zuerst ein "
"Passwort fest."

#. Context: Settings › Linked accounts › confirmation
#: auth.py:988
msgid "Provider disconnected."
msgstr "Anbieter getrennt."

#. Context: Settings › Set a password › error. 'Change' must match the button.
#: auth.py:1004
msgid "This account already has a password — use Change instead."
msgstr "Dieses Konto hat bereits ein Passwort – nutze stattdessen Ändern."

#. Context: Settings › confirmation
#: auth.py:1010
msgid "Password set."
msgstr "Passwort festgelegt."

#. Context: Settings › Change password › error
#: auth.py:1194
msgid "Current password is incorrect."
msgstr "Das aktuelle Passwort ist falsch."

#. Context: Settings › confirmation
#: auth.py:1200
msgid "Password changed."
msgstr "Passwort geändert."

#. Context: Settings › Excel export error
#: backup.py:134
