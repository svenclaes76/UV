#: auth.py:813
msgid "Session not found."
msgstr "Sitzung nicht gefunden."

#. Context: Settings › Active sessions › confirmation
#: auth.py:817
msgid "Signed out of that session."
msgstr "Von dieser Sitzung abgemeldet."

#. Context: Settings › confirmation after 'Sign out everywhere else'
#: auth.py:835
#, python-brace-format
msgid "Signed out of {count} other session."
msgid_plural "Signed out of {count} other sessions."
msgstr[0] "Von {count} anderen Sitzung abgemeldet."
msgstr[1] "Von {count} anderen Sitzungen abgemeldet."

#. Context: Settings › 2FA setup › error
#: auth.py:884
msgid "Start enrollment again — no pending setup found."
msgstr "Starte die Einrichtung erneut – keine laufende Einrichtung gefunden."

#. Context: 2FA sign-in and setup › error
#: auth.py:886 auth.py:989
msgid "That code didn't match. Try again."
msgstr "Dieser Code stimmt nicht. Versuche es erneut."

#. Context: Settings › confirmation
#: auth.py:893
msgid "Two-factor authentication enabled."
msgstr "Zwei-Faktor-Authentifizierung aktiviert."

#. Context: Settings › confirmation
#: auth.py:910
msgid "Two-factor authentication turned off."
msgstr "Zwei-Faktor-Authentifizierung deaktiviert."

#. Context: Sign-in › error while the account is locked
#: auth.py:962
#, python-brace-format
msgid "This account is temporarily locked. Try again in {count} minute."
msgid_plural "This account is temporarily locked. Try again in {count} minutes."
msgstr[0] "Dieses Konto ist vorübergehend gesperrt. Versuche es in {count} Minute erneut."
msgstr[1] "Dieses Konto ist vorübergehend gesperrt. Versuche es in {count} Minuten erneut."

#: auth.py:983
#, python-brace-format
msgid "That code didn't match. Too many failed attempts — this account is now locked for {minutes} minutes."
msgstr "Dieser Code stimmt nicht. Zu viele Fehlversuche – dieses Konto ist jetzt {minutes} Minuten gesperrt."

#. Context: Settings / sign-in › error
#: auth.py:1019 auth.py:1045
msgid "Two-factor authentication isn't enabled for this account."
msgstr "Die Zwei-Faktor-Authentifizierung ist für dieses Konto nicht aktiviert."

#. Context: Settings › confirmation after 'Revoke all'
#: auth.py:1154
msgid "All trusted devices revoked."
msgstr "Alle vertrauenswürdigen Geräte widerrufen."

#. Context: Password forms › error
#: auth.py:1200
msgid "This password has appeared in known data breaches. Choose a different one."
msgstr "Dieses Passwort ist in bekannten Datenlecks aufgetaucht. Wähle ein anderes."

#. Context: Settings › Linked accounts › error
#: auth.py:1234
msgid "This identity is already linked to a different account."
msgstr "Diese Identität ist bereits mit einem anderen Konto verknüpft."

#. Context: Settings › Linked accounts › error
#: auth.py:1237
msgid "This provider is already linked to your account."
msgstr "Dieser Anbieter ist bereits mit deinem Konto verknüpft."

#. Context: Settings › Linked accounts › confirmation
#: auth.py:1244
msgid "Provider connected."
msgstr "Anbieter verbunden."

#. Context: Settings › Linked accounts › error
#: auth.py:1259
msgid "That provider isn't linked to your account."
msgstr "Dieser Anbieter ist nicht mit deinem Konto verknüpft."

#. Context: Settings › Linked accounts › error
#: auth.py:1261
msgid "Can't disconnect your only sign-in method — set a password first."
msgstr "Deine einzige Anmeldemethode kann nicht getrennt werden – lege zuerst ein Passwort fest."

#. Context: Settings › Linked accounts › confirmation
#: auth.py:1266
msgid "Provider disconnected."
msgstr "Anbieter getrennt."

#. Context: Settings › Set a password › error. 'Change' must match the button.
#: auth.py:1282
msgid "This account already has a password — use Change instead."
msgstr "Dieses Konto hat bereits ein Passwort – nutze stattdessen Ändern."

#. Context: Settings › confirmation
#: auth.py:1288
msgid "Password set."
msgstr "Passwort festgelegt."

#. Context: Settings › Change password › error
#: auth.py:1474
msgid "Current password is incorrect."
msgstr "Das aktuelle Passwort ist falsch."

#. Context: Settings › confirmation
#: auth.py:1480
msgid "Password changed."
msgstr "Passwort geändert."

