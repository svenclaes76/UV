#: auth.py:160
msgid "Account created. You can now log in."
msgstr "Compte créé. Tu peux maintenant te connecter."

#. Context: Invite acceptance › error when signing in with a different SSO
#. account
#: auth.py:317
#, python-brace-format
msgid ""
"This invite was sent to {email}. Sign in with a matching account, or ask your "
"admin to invite {provider_email}."
msgstr ""
"Cette invitation a été envoyée à {email}. Connecte-toi avec le compte "
"correspondant ou demande à ton administrateur d'inviter {provider_email}."

