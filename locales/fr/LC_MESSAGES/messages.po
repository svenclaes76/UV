#: auth.py:473
msgid "Invalid email or password."
msgstr "E-mail ou mot de passe incorrect."

#. Context: Sign-in › error while the account is locked
#: auth.py:488
#, python-brace-format
msgid "This account is temporarily locked. Try again in {count} minute."
msgid_plural "This account is temporarily locked. Try again in {count} minutes."
msgstr[0] "Ce compte est temporairement bloqué. Réessaie dans {count} minute."
msgstr[1] "Ce compte est temporairement bloqué. Réessaie dans {count} minutes."

#. Context: Sign-in › error when the account gets locked
#: auth.py:509
#, python-brace-format
msgid ""
"Invalid email or password. Too many failed attempts — this account is now locked "
"for {minutes} minutes."
msgstr ""
"E-mail ou mot de passe incorrect. Trop de tentatives échouées : ce compte est "
"maintenant bloqué pendant {minutes} minutes."

#. Context: Sign-in › error with remaining attempts
#: auth.py:516
#, python-brace-format
msgid ""
"Invalid email or password. {count} attempt remains before this account is locked "
"for {minutes} minutes."
msgid_plural ""
"Invalid email or password. {count} attempts remain before this account is locked "
"for {minutes} minutes."
msgstr[0] ""
"E-mail ou mot de passe incorrect. Il reste {count} tentative avant le blocage du "
"compte pendant {minutes} minutes."
msgstr[1] ""
"E-mail ou mot de passe incorrect. Il reste {count} tentatives avant le blocage du "
"compte pendant {minutes} minutes."

