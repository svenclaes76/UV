#: uvalu/pages_/settings.py:645
msgid "Extend the screener beyond European exchanges."
msgstr "Estendi lo screener oltre le borse europee."

#. Context: Settings › section heading
#: uvalu/pages_/settings.py:681
msgid "Target allocation"
msgstr "Allocazione obiettivo"

#. Context: Settings › Target allocation description
#: uvalu/pages_/settings.py:682
msgid ""
"Your personal reference weights. When any are set, the Risk page's rebalancing "
"signals switch from absolute thresholds to drift-vs-target."
msgstr ""
"I tuoi pesi di riferimento personali. Quando ne imposti uno, i segnali di "
"ribilanciamento della pagina Rischio passano da soglie assolute allo scostamento "
"dall'obiettivo."

#. Context: Settings › Target allocation › row title and field label
#: uvalu/pages_/settings.py:687 uvalu/pages_/settings.py:690
msgid "Sector targets"
msgstr "Obiettivi per settore"

#. Context: Settings › Sector targets description
#: uvalu/pages_/settings.py:688
#, no-python-format
msgid "Blank = no sector targets; the 30% guideline applies instead."
msgstr "Vuoto = nessun obiettivo per settore; si applica la regola del 30%."

#. Context: Settings › Sector targets › example text inside the empty box.
#. Sector names in the example should be the translated ones.
#: uvalu/pages_/settings.py:692
#, no-python-format
msgid ""
"One per line — sector and target %:\n"
"Technology 25\n"
"Healthcare 15"
msgstr ""
"Uno per riga: settore e obiettivo %:\n"
"Tecnologia 25\n"
"Sanità 15"

#. Context: Settings › Target allocation › row title and field label
#: uvalu/pages_/settings.py:695 uvalu/pages_/settings.py:698
msgid "Per-name targets"
msgstr "Obiettivi per titolo"

#. Context: Settings › Per-name targets description
#: uvalu/pages_/settings.py:696
#, no-python-format
msgid "Blank = no per-name targets; only the 20% hard cap applies."
msgstr ""
"Vuoto = nessun obiettivo per titolo; si applica solo il limite rigido del 20%."

#. Context: Settings › Per-name targets › example text inside the empty box.
#. Use the local decimal separator in 7.5.
#: uvalu/pages_/settings.py:700
#, no-python-format
msgid ""
"One per line — ticker and target %:\n"
"AAA.BR 10\n"
"BBB.PA 7.5"
msgstr ""
"Uno per riga: ticker e obiettivo %:\n"
"AAA.BR 10\n"
"BBB.PA 7,5"

#. Context: Settings › Target allocation › row title and field label
#: uvalu/pages_/settings.py:704 uvalu/pages_/settings.py:707
msgid "Concentration ceiling (HHI)"
msgstr "Tetto di concentrazione (HHI)"

#. Context: Settings › HHI description. Use the local decimal separator.
#: uvalu/pages_/settings.py:705
msgid "Flag when portfolio HHI exceeds this. 0 = use the default 0.10 / 0.18 bands."
msgstr ""
"Segnala quando l'HHI del portafoglio supera questo valore. 0 = fasce predefinite "
"0,10 / 0,18."

#. Context: Settings › Target allocation › save button
#: uvalu/pages_/settings.py:712
msgid "Save target allocation"
msgstr "Salva allocazione obiettivo"

#. Context: Settings › toast after saving
#: uvalu/pages_/settings.py:724
msgid "Target allocation saved."
msgstr "Allocazione obiettivo salvata."

#. Context: Settings › section heading
#: uvalu/pages_/settings.py:729
msgid "Data"
msgstr "Dati"

#. Context: Settings › Data › row title
#: uvalu/pages_/settings.py:742
msgid "Price refresh interval"
msgstr "Intervallo di aggiornamento dei prezzi"

#. Context: Settings › Data › refresh interval description
#: uvalu/pages_/settings.py:743
msgid "How often quotes update during market hours."
msgstr "Ogni quanto si aggiornano le quotazioni durante l'orario di mercato."

#. Context: Settings › Data › toggle title
#: uvalu/pages_/settings.py:761
msgid "Ex-dividend alerts"
msgstr "Avvisi di stacco"

#. Context: Settings › Data › toggle description
#: uvalu/pages_/settings.py:762
msgid "Flag holdings going ex-dividend within 7 days on the Dashboard."
msgstr "Segnala nella dashboard le posizioni con stacco entro 7 giorni."

#. Context: Settings › Data › slider label under Ex-dividend alerts
#: uvalu/pages_/settings.py:772
msgid "Only above this position weight"
msgstr "Solo sopra questo peso della posizione"

#. Context: Settings › Data › slider value when set to 0%
#: uvalu/pages_/settings.py:773
msgid "any size"
msgstr "qualsiasi dimensione"

#. Context: Settings › Data › slider description
#: uvalu/pages_/settings.py:774
#, no-python-format
msgid "0% flags every held ex-date; raise it to only badge your larger positions."
msgstr ""
"Con 0% viene segnalata ogni data di stacco; aumentalo per segnalare solo le "
"posizioni più grandi."

#. Context: Settings › Data › toggle title
#: uvalu/pages_/settings.py:785
msgid "Dividend cut / suspension alerts"
msgstr "Avvisi di taglio / sospensione del dividendo"

#. Context: Settings › Data › toggle description
#: uvalu/pages_/settings.py:786
msgid "Flag a holding on the Dashboard when its dividend was just cut or suspended."
msgstr ""
"Segnala una posizione nella dashboard quando il suo dividendo è appena stato "
"tagliato o sospeso."

#. Context: Settings › Data › toggle title
#: uvalu/pages_/settings.py:794
msgid "Dividend increase alerts"
msgstr "Avvisi di aumento del dividendo"

#. Context: Settings › Data › toggle description
#: uvalu/pages_/settings.py:795
msgid "Flag a holding on the Dashboard when its dividend was just raised."
msgstr ""
"Segnala una posizione nella dashboard quando il suo dividendo è appena stato "
"aumentato."

#. Context: Settings › section heading
#: uvalu/pages_/settings.py:804
msgid "Dividend withholding"
msgstr "Ritenuta sui dividendi"

#. Context: Settings › Dividend withholding description
#: uvalu/pages_/settings.py:805
#, no-python-format
msgid ""
"Default withholding tax % applied when you record a dividend on each exchange — "
"always editable per record. Depends on your own tax residency and treaty, which "
"this app has no way to know, so every rate starts at 0% until you set it."
msgstr ""
"Percentuale di ritenuta predefinita applicata quando registri un dividendo su "
"ciascuna borsa, sempre modificabile per singolo record. Dipende dalla tua "
"residenza fiscale e dalla convenzione applicabile, che l'app non può conoscere, "
"quindi ogni aliquota parte da 0% finché non la imposti."

#. Context: Settings › section heading
#: uvalu/pages_/settings.py:825
msgid "Import & export"
msgstr "Importazione ed esportazione"

#. Context: Settings › Import portfolio description
#: uvalu/pages_/settings.py:832
msgid ""
"Upload an Excel file to import positions, sold history and dividends. This "
"replaces all existing portfolio data for this account."
msgstr ""
"Carica un file Excel per importare posizioni, storico delle vendite e dividendi. "
"Sostituisce tutti i dati di portafoglio esistenti di questo account."

#. Context: Settings › file upload label
#: uvalu/pages_/settings.py:833
msgid "Choose your portfolio .xlsx file"
msgstr "Scegli il file .xlsx del portafoglio"

#. Context: Settings › loading message during import
#: uvalu/pages_/settings.py:836
msgid "Parsing Excel…"
msgstr "Lettura del file Excel…"

#. Context: Settings › import error. Keep the exchange codes as they are.
#: uvalu/pages_/settings.py:840
msgid ""
"No open EBR:/AMS:/EPA:/BIT:/ETR:/SWX: positions found. Check that your file "
"matches the expected format."
msgstr ""
"Nessuna posizione aperta EBR:/AMS:/EPA:/BIT:/ETR:/SWX: trovata. Verifica che il "
"file rispetti il formato previsto."

#. Context: Settings › success message after import
#: uvalu/pages_/settings.py:849
#, python-brace-format
msgid "Imported {open} open, {sold} sold, {dividends} dividend records."
msgstr "Importati: {open} aperte, {sold} vendute, {dividends} dividendi."

#. Context: Settings › import error; {error} is a technical message (stays
#. English)
#: uvalu/pages_/settings.py:853
#, python-brace-format
msgid "Could not parse file: {error}"
msgstr "Impossibile leggere il file: {error}"

#. Context: Settings › row title
#: uvalu/pages_/settings.py:858
msgid "Excel export"
msgstr "Esportazione Excel"

#. Context: Settings › Excel export description
#: uvalu/pages_/settings.py:859
msgid ""
"Human-readable workbook with positions, dividends, sold history and watchlist. "
"Useful for inspection or migration."
msgstr ""
"Cartella di lavoro leggibile con posizioni, dividendi, storico delle vendite e "
"watchlist. Utile per controlli o migrazioni."

#. Context: Settings › download button (keep the file name)
#: uvalu/pages_/settings.py:863
msgid "Download backup.xlsx"
msgstr "Scarica backup.xlsx"

#. Context: Settings › export notice
#: uvalu/pages_/settings.py:869
msgid ""
"Your portfolio is empty. Add positions in the Portfolio section first, then come "
"back to export."
msgstr ""
"Il tuo portafoglio è vuoto. Aggiungi prima delle posizioni in Portafoglio, poi "
"torna qui per esportare."

#. Context: Settings › export error; {error} is technical (stays English)
#: uvalu/pages_/settings.py:871
#, python-brace-format
msgid "Could not create Excel: {error}"
msgstr "Impossibile creare il file Excel: {error}"

#. Context: Watchlist › caption under the title
#: uvalu/pages_/watchlist.py:66
msgid ""
"Track tickers you don't hold yet. Add from the screener with the star, or type a "
"symbol directly below."
msgstr ""
"Segui i ticker che non possiedi ancora. Aggiungili dallo screener con la stella o "
"digita un simbolo qui sotto."

#. Context: Watchlist › submit button
#: uvalu/pages_/watchlist.py:98
msgid "Add ticker"
msgstr "Aggiungi ticker"

#. Context: Watchlist › field label
#: uvalu/pages_/watchlist.py:107 uvalu/pages_/watchlist.py:109
msgid "Company name (optional)"
msgstr "Nome della società (facoltativo)"

#. Context: Watchlist › empty state
#: uvalu/pages_/watchlist.py:143
msgid "Your watchlist is empty. Star a ticker in the screener or add one above."
msgstr ""
"La tua watchlist è vuota. Metti una stella a un ticker nello screener o aggiungine "
"uno qui sopra."

#. Context: Watchlist › loading caption
#: uvalu/pages_/watchlist.py:154
#, python-brace-format
msgid ""
"Fetching data for your {count} watchlisted ticker… {done}/{total} companies scored."
msgid_plural ""
"Fetching data for your {count} watchlisted tickers… {done}/{total} companies "
"scored."
msgstr[0] ""
"Recupero dei dati per il tuo {count} ticker in watchlist… {done}/{total} società "
"valutate."
msgstr[1] ""
"Recupero dei dati per i tuoi {count} ticker in watchlist… {done}/{total} società "
"valutate."

#. Context: Watchlist › note when data isn't loaded yet
#: uvalu/pages_/watchlist.py:158
msgid ""
"No screener data yet for your watchlisted ticker — it will appear after the next "
"screener refresh."
msgid_plural ""
"No screener data yet for your watchlisted tickers — they'll appear after the next "
"screener refresh."
msgstr[0] ""
"Nessun dato dello screener per il tuo ticker in watchlist: comparirà dopo il "
"prossimo aggiornamento."
msgstr[1] ""
"Nessun dato dello screener per i tuoi ticker in watchlist: compariranno dopo il "
"prossimo aggiornamento."

