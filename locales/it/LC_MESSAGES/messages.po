#, python-brace-format
msgid "Password must be at least {min_len} characters."
msgstr "La password deve contenere almeno {min_len} caratteri."

#. Context: First-run/sign-up › error
#: auth.py:138
msgid ""
"The user store could not be read (wrong encryption key or a corrupted file). "
"Registration is disabled until this is fixed."
msgstr ""
"Impossibile leggere l'archivio utenti (chiave di cifratura errata o file "
"danneggiato). La registrazione è disattivata finché il problema non viene risolto."

