#: auth.py:140
msgid "An account with this email already exists."
msgstr "Esiste già un account con questa email."

#. Context: Sign-up › success message
#: auth.py:160
msgid "Account created. You can now log in."
msgstr "Account creato. Ora puoi accedere."

#. Context: Invite acceptance › error when signing in with a different SSO
#. account
#: auth.py:317
#, python-brace-format
msgid ""
"This invite was sent to {email}. Sign in with a matching account, or ask your "
"admin to invite {provider_email}."
msgstr ""
"Questo invito è stato inviato a {email}. Accedi con l'account corrispondente o "
"chiedi al tuo amministratore di invitare {provider_email}."

#. Context: Sign-in › error
#: auth.py:468
msgid ""
"The user store could not be read (wrong encryption key or a corrupted file). "
"Contact your administrator."
msgstr ""
"Impossibile leggere l'archivio utenti (chiave di cifratura errata o file "
"danneggiato). Contatta il tuo amministratore."

#. Context: Sign-in › error
#: auth.py:473
msgid "Invalid email or password."
msgstr "Email o password non validi."

#. Context: Sign-in › error while the account is locked
#: auth.py:488
#, python-brace-format
msgid "This account is temporarily locked. Try again in {count} minute."
msgid_plural "This account is temporarily locked. Try again in {count} minutes."
msgstr[0] "Questo account è temporaneamente bloccato. Riprova tra {count} minuto."
msgstr[1] "Questo account è temporaneamente bloccato. Riprova tra {count} minuti."

#. Context: Sign-in › error when the account gets locked
#: auth.py:509
#, python-brace-format
msgid ""
"Invalid email or password. Too many failed attempts — this account is now locked "
"for {minutes} minutes."
msgstr ""
"Email o password non validi. Troppi tentativi non riusciti: questo account è ora "
"bloccato per {minutes} minuti."

#. Context: Sign-in › error with remaining attempts
#: auth.py:516
#, python-brace-format
msgid ""
"Invalid email or password. {count} attempt remains before this account is locked "
"for {minutes} minutes."
msgid_plural ""
"Invalid email or password. {count} attempts remain before this account is locked "
"for {minutes} minutes."
msgstr[0] ""
"Email o password non validi. Resta {count} tentativo prima che l'account venga "
"bloccato per {minutes} minuti."
msgstr[1] ""
"Email o password non validi. Restano {count} tentativi prima che l'account venga "
"bloccato per {minutes} minuti."

