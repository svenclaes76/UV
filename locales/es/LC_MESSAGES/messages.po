#, python-brace-format
msgid "Password must be at least {min_len} characters."
msgstr "La contraseña debe tener al menos {min_len} caracteres."

#. Context: First-run/sign-up › error
#: auth.py:138
msgid ""
"The user store could not be read (wrong encryption key or a corrupted file). "
"Registration is disabled until this is fixed."
msgstr ""
"No se ha podido leer el almacén de usuarios (clave de cifrado incorrecta o "
"archivo dañado). El registro está desactivado hasta que se solucione."

