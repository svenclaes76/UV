#: auth.py:140
msgid "An account with this email already exists."
msgstr "Ya existe una cuenta con este correo."

#. Context: Sign-up › success message
#: auth.py:160
msgid "Account created. You can now log in."
msgstr "Cuenta creada. Ya puedes iniciar sesión."

#. Context: Invite acceptance › error when signing in with a different SSO
#. account
#: auth.py:317
#, python-brace-format
msgid ""
"This invite was sent to {email}. Sign in with a matching account, or ask your "
"admin to invite {provider_email}."
msgstr ""
"Esta invitación se envió a {email}. Inicia sesión con la cuenta correspondiente "
"o pide a tu administrador que invite a {provider_email}."

#. Context: Sign-in › error
#: auth.py:468
msgid ""
"The user store could not be read (wrong encryption key or a corrupted file). "
"Contact your administrator."
msgstr ""
"No se ha podido leer el almacén de usuarios (clave de cifrado incorrecta o "
"archivo dañado). Ponte en contacto con tu administrador."

#. Context: Sign-in › error
#: auth.py:473
msgid "Invalid email or password."
msgstr "Correo o contraseña incorrectos."

#. Context: Sign-in › error while the account is locked
#: auth.py:488
#, python-brace-format
msgid "This account is temporarily locked. Try again in {count} minute."
msgid_plural "This account is temporarily locked. Try again in {count} minutes."
msgstr[0] ""
"Esta cuenta está bloqueada temporalmente. Vuelve a intentarlo dentro de {count} "
"minuto."
msgstr[1] ""
"Esta cuenta está bloqueada temporalmente. Vuelve a intentarlo dentro de {count} "
"minutos."

#. Context: Sign-in › error when the account gets locked
#: auth.py:509
#, python-brace-format
msgid ""
"Invalid email or password. Too many failed attempts — this account is now locked "
"for {minutes} minutes."
msgstr ""
"Correo o contraseña incorrectos. Demasiados intentos fallidos: esta cuenta queda "
"bloqueada durante {minutes} minutos."

#. Context: Sign-in › error with remaining attempts
#: auth.py:516
#, python-brace-format
msgid ""
"Invalid email or password. {count} attempt remains before this account is locked "
"for {minutes} minutes."
msgid_plural ""
"Invalid email or password. {count} attempts remain before this account is locked "
"for {minutes} minutes."
msgstr[0] ""
"Correo o contraseña incorrectos. Queda {count} intento antes de que la cuenta se "
"bloquee durante {minutes} minutos."
msgstr[1] ""
"Correo o contraseña incorrectos. Quedan {count} intentos antes de que la cuenta "
"se bloquee durante {minutes} minutos."

