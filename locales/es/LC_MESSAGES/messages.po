msgid_plural "This account is temporarily locked. Try again in {count} minutes."
msgstr[0] "Esta cuenta está bloqueada temporalmente. Vuelve a intentarlo dentro de {count} minuto."
msgstr[1] "Esta cuenta está bloqueada temporalmente. Vuelve a intentarlo dentro de {count} minutos."

#: auth.py:983
#, python-brace-format
msgid "That code didn't match. Too many failed attempts — this account is now locked for {minutes} minutes."
msgstr "Ese código no coincide. Demasiados intentos fallidos: esta cuenta queda bloqueada durante {minutes} minutos."

#. Context: Settings / sign-in › error
#: auth.py:1019 auth.py:1045
msgid "Two-factor authentication isn't enabled for this account."
msgstr "La autenticación en dos pasos no está activada en esta cuenta."

